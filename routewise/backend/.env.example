# Copy this file to .env and fill in real values. Never commit the real .env file.

# Database
DB_URL=jdbc:postgresql://localhost:5432/routewise
DB_USERNAME=routewise
DB_PASSWORD=change-me

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# JWT - generate a long random string (32+ bytes) for production
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRATION_MS=86400000

# CORS - comma separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Geocoding provider (defaults to public Nominatim - replace with your own provider/key for production use)
GEOCODING_PROVIDER_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=RouteWise/1.0 (contact@example.com)

SERVER_PORT=8080
LOG_LEVEL=INFO
